@model CleanFirmeza.Application.DTOs.Auth.RegisterDto

@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">Iniciar sesion</h2>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="juan@ejemplo.com" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                        <small class="form-text text-muted">
                            Mínimo 6 caracteres, debe incluir mayúscula, minúscula, número y carácter especial.
                        </small>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    

                    <div class="text-center mt-3">
                        <p>¿No tienes cuenta? <a asp-action="Register" asp-controller="Auth">Registrate aquí</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

 